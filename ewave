#!/usr/bin/env bash
set -euo pipefail

ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
JAR="$ROOT/target/ewave-0.1.0-SNAPSHOT.jar"

die() { printf 'ewave: %s\n' "$*" >&2; exit 1; }

help() {
    cat <<'EOF'
Usage:
  ./ewave                 Open the ewave launcher menu
  ./ewave restore IFACE   Emergency command to return an adapter to managed Wi-Fi

Live Wi-Fi, Replay, and Open dashboard without capture start the API and dashboard.
Press Ctrl+C to stop the session cleanly and restore your Wi-Fi adapter.
EOF
}

discover_adapters() {
    command -v iw >/dev/null 2>&1 || return 0
    iw dev 2>/dev/null | awk '
        /^[[:space:]]*Unnamed\/non-netdev/ { in_iface = 0; next }
        /^[[:space:]]*Interface[[:space:]]+/ {
            if (iface != "") print iface "|" type "|" freq "|" ch "|" ssid
            iface = $2; type = ""; freq = ""; ch = ""; ssid = ""; in_iface = 1; next
        }
        in_iface && $1 == "type" { type = $2 }
        in_iface && $1 == "ssid" {
            sub(/^[[:space:]]*ssid[[:space:]]+/, "", $0)
            ssid = $0
        }
        in_iface && $1 == "channel" {
            ch = $2; freq = $3; gsub(/[^0-9]/, "", freq)
        }
        END {
            if (iface != "") print iface "|" type "|" freq "|" ch "|" ssid
        }
    ' || true
}

discover_pcaps() {
    local -a candidates=()
    local f
    for f in "$PWD"/*.pcap "$ROOT"/*.pcap "$ROOT"/src/test/resources/probes/*.pcap; do
        [[ -f "$f" && -r "$f" ]] || continue
        local dup=false existing
        for existing in "${candidates[@]+"${candidates[@]}"}"; do
            if [[ "$existing" == "$f" ]]; then dup=true; break; fi
        done
        if [[ "$dup" == false ]]; then candidates+=("$f"); fi
    done
    printf '%s\n' "${candidates[@]+"${candidates[@]}"}"
}

CHOSEN_ADAPTER=

choose_adapter() {
    local -a rows=()
    local line
    CHOSEN_ADAPTER=
    while IFS= read -r line; do
        [[ -n "$line" ]] && rows+=("$line")
    done < <(discover_adapters)

    if (( ${#rows[@]} > 0 )); then
        printf '\nAvailable Wi-Fi adapters:\n'
        local i=1 iface type freq ch ssid desc
        for line in "${rows[@]}"; do
            IFS='|' read -r iface type freq ch ssid <<< "$line"
            ssid=$(printf '%s' "$ssid" | tr -d '[:cntrl:]')
            desc="${type:-unknown}"
            if [[ -n "$ch" && -n "$freq" ]]; then
                desc="$desc · Ch $ch · ${freq} MHz"
            fi
            if [[ -n "$ssid" ]]; then
                desc="$desc · $ssid"
            fi
            printf '  %d) %s (%s)\n' "$i" "$iface" "$desc"
            ((i++))
        done
        printf '  0) Back\n'
        local pick
        read -r -p 'Choose adapter # (or enter interface name): ' pick || return 1
        [[ -n "$pick" && "$pick" != 0 ]] || return 1
        if [[ "$pick" =~ ^[0-9]+$ ]] && (( pick >= 1 && pick <= ${#rows[@]} )); then
            IFS='|' read -r CHOSEN_ADAPTER _ <<< "${rows[pick-1]}"
            return 0
        fi
        CHOSEN_ADAPTER=$pick
        return 0
    fi
    local iface
    read -r -p 'Wi-Fi interface (blank to cancel): ' iface || return 1
    [[ -n "$iface" ]] || return 1
    CHOSEN_ADAPTER=$iface
}

ORIG_TYPE=
ORIG_FREQ=
ORIG_UP=false
ORIG_NM_MANAGED=no
ORIG_CONNECTION=
NEED_RESTORE=false
NM_CHANGED=false
CLEANUP_DONE=false
RESTORED_IFACE=
FRONTEND_PID=

stop_frontend() {
    if [[ -n "${FRONTEND_PID:-}" ]]; then
        kill "$FRONTEND_PID" 2>/dev/null || true
        wait "$FRONTEND_PID" 2>/dev/null || true
        FRONTEND_PID=
    fi
}

start_frontend() {
    if [[ ! -f "$ROOT/frontend/node_modules/vite/bin/vite.js" ]] || ! command -v node >/dev/null 2>&1; then
        printf 'Frontend dependencies not installed; run "cd frontend && npm install" once to enable auto-started UI.\n'
        return 0
    fi

    local log_file url attempt
    if ! log_file=$(mktemp "${TMPDIR:-/tmp}/ewave-frontend.XXXXXXXX.log"); then
        printf 'Could not create a dashboard log. Starting the API only.\n' >&2
        return 0
    fi
    (
        cd -- "$ROOT/frontend"
        NO_COLOR=1 exec node node_modules/vite/bin/vite.js --configLoader runner --host 127.0.0.1 --clearScreen false
    ) </dev/null >"$log_file" 2>&1 &
    FRONTEND_PID=$!
    for ((attempt = 0; attempt < 100; attempt++)); do
        kill -0 "$FRONTEND_PID" 2>/dev/null || break
        url=$(sed -nE 's@.*Local:[[:space:]]+(http://127\.0\.0\.1:[0-9]+/).*@\1@p' "$log_file")
        if [[ -n "$url" ]]; then
            printf 'Dashboard: %s (logs: %s)\n' "$url" "$log_file"
            return 0
        fi
        sleep 0.1
    done
    stop_frontend
    printf 'Dashboard failed to start. Starting the API only (logs: %s).\n' "$log_file" >&2
}

restore_recorded_adapter() {
    local iface=$RESTORED_IFACE
    local rc=0
    [[ -n "$iface" ]] || return 0
    printf 'Restoring %s to its pre-session state (%s)...\n' "$iface" "$ORIG_TYPE" >&2
    if [[ "$ORIG_TYPE" == managed ]]; then
        sudo ip link set "$iface" down || rc=1
        sudo iw dev "$iface" set type managed || rc=1
        if [[ "$ORIG_UP" == true ]]; then
            sudo ip link set "$iface" up || rc=1
        fi
        if [[ "$NM_CHANGED" == true ]]; then
            sudo nmcli device set "$iface" managed yes || rc=1
        fi
        if [[ -n "$ORIG_CONNECTION" && "$ORIG_CONNECTION" != -- ]] && command -v nmcli >/dev/null 2>&1; then
            nmcli connection up id "$ORIG_CONNECTION" ifname "$iface" >/dev/null 2>&1 || true
        fi
    fi
    return "$rc"
}

cleanup_session() {
    if [[ "$CLEANUP_DONE" == true ]]; then return 0; fi
    CLEANUP_DONE=true
    stop_frontend
    if [[ "$NEED_RESTORE" == true ]]; then
        if ! restore_recorded_adapter; then
            printf 'Adapter restoration failed. Recover manually with: ./ewave restore %s\n' "$RESTORED_IFACE" >&2
        fi
    fi
}

prepare_monitor() {
    local iface=$1 info link flags answer tool
    [[ "$iface" =~ ^[a-zA-Z0-9_.:-]+$ && "$iface" != -* ]] || die 'Invalid interface name.'
    for tool in ip iw sudo; do
        command -v "$tool" >/dev/null 2>&1 || die "Monitor setup requires $tool."
    done
    info=$(iw dev "$iface" info) || die "Cannot inspect wireless interface: $iface"
    ORIG_TYPE=$(printf '%s\n' "$info" | awk '$1 == "type" {print $2; exit}')
    ORIG_FREQ=$(printf '%s\n' "$info" | awk '$1 == "channel" {gsub(/[^0-9]/, "", $3); print $3; exit}')
    RESTORED_IFACE=$iface

    if [[ "$ORIG_TYPE" == monitor ]]; then
        printf '%s is already in monitor mode.\n' "$iface"
        return 0
    fi
    [[ "$ORIG_TYPE" == managed ]] || die "Expected managed or monitor mode; found: $ORIG_TYPE"

    link=$(ip -o link show dev "$iface") || die 'Cannot inspect interface link state.'
    flags=${link#*<}; flags=${flags%%>*}
    if [[ ",$flags," == *,UP,* ]]; then ORIG_UP=true; else ORIG_UP=false; fi
    if command -v nmcli >/dev/null 2>&1; then
        ORIG_NM_MANAGED=$(LC_ALL=C nmcli -g GENERAL.NM-MANAGED device show "$iface") ||
            die 'Cannot read NetworkManager state. Prepare monitor mode manually and retry this command.'
        [[ "$ORIG_NM_MANAGED" == yes || "$ORIG_NM_MANAGED" == no ]] || die 'Unexpected NetworkManager managed state.'
        ORIG_CONNECTION=$(LC_ALL=C nmcli -g GENERAL.CONNECTION device show "$iface" 2>/dev/null || true)
    fi

    printf 'This will disconnect Wi-Fi on %s and put that adapter into monitor mode.\n' "$iface"
    printf 'Only the selected adapter is changed; your original state will be restored on exit.\n'
    printf 'If needed later, run ./ewave restore %s to return to normal Wi-Fi.\n' "$iface"
    read -r -p 'Type monitor to continue (anything else cancels): ' answer || return 2
    [[ "$answer" == monitor ]] || { printf 'Monitor setup cancelled.\n'; return 2; }
    sudo -v || die 'Administrator authorization failed; networking was not changed.'

    NEED_RESTORE=true
    trap cleanup_session EXIT
    trap 'exit 130' INT
    trap 'exit 143' TERM

    if [[ "$ORIG_NM_MANAGED" == yes ]]; then
        NM_CHANGED=true
        sudo nmcli device set "$iface" managed no || die 'Could not release the adapter from NetworkManager.'
    fi
    sudo ip link set "$iface" down || die 'Could not bring the interface down.'
    sudo iw dev "$iface" set type monitor || die 'The driver could not enable monitor mode.'
    sudo ip link set "$iface" up || die 'Could not bring the monitor interface up.'
    if [[ "$ORIG_FREQ" =~ ^[0-9]+$ ]]; then
        sudo iw dev "$iface" set freq "$ORIG_FREQ" || die "Could not tune to $ORIG_FREQ MHz."
    fi
    info=$(iw dev "$iface" info) || die 'Could not verify monitor mode.'
    [[ "$(printf '%s\n' "$info" | awk '$1 == "type" {print $2; exit}')" == monitor ]] ||
        die 'The interface did not remain in monitor mode.'
    printf 'Monitor mode ready.\n'
    return 0
}

restore_network() {
    local iface=$1 answer tool
    [[ "$(uname -s)" == Linux ]] || die 'Network recovery requires Linux.'
    [[ "$iface" =~ ^[a-zA-Z0-9_.:-]+$ && "$iface" != -* ]] || die 'Invalid interface name.'
    for tool in ip iw systemctl sudo; do
        command -v "$tool" >/dev/null 2>&1 || die "Network recovery requires $tool."
    done
    iw dev "$iface" info >/dev/null || die "Cannot inspect wireless interface: $iface"
    printf 'Stop ewave capture sessions before recovery.\n'
    printf 'This will disconnect %s, switch it to managed mode, bring it up, and start NetworkManager.\n' "$iface"
    printf 'It restores normal managed Wi-Fi, not a saved prior configuration or factory defaults.\n'
    read -r -p 'Type restore to continue (anything else cancels): ' answer || return 0
    [[ "$answer" == restore ]] || { printf 'Recovery cancelled.\n'; return 0; }
    sudo -v || die 'Administrator authorization failed; networking was not changed.'
    sudo ip link set "$iface" down || die 'Could not bring the interface down.'
    if ! sudo iw dev "$iface" set type managed; then
        sudo ip link set "$iface" up || true
        die 'Could not switch to managed mode; attempted to bring the interface back up.'
    fi
    sudo ip link set "$iface" up || die 'Could not bring the interface up; retry recovery.'
    sudo systemctl start NetworkManager || die 'Could not start NetworkManager; check your network service.'
    if command -v nmcli >/dev/null 2>&1; then
        sudo nmcli device set "$iface" managed yes || die 'Could not return the interface to NetworkManager.'
    fi
    printf 'Managed Wi-Fi restored. Reconnect using your network menu if needed.\n'
}

check_java() {
    command -v java >/dev/null 2>&1 || die 'Java 21 or newer is required.'
    local version major
    version=$(java -version 2>&1) || die 'Unable to run Java.'
    major=$(printf '%s\n' "$version" | sed -nE 's/.*version "([0-9]+).*/\1/p' | head -n 1)
    [[ "$major" =~ ^[0-9]+$ ]] && (( major >= 21 )) || die 'Java 21 or newer is required.'
}

build() {
    check_java
    local compiler=javac compilerVersion compilerMajor
    if [[ -n "${JAVA_HOME:-}" ]]; then compiler="$JAVA_HOME/bin/javac"; fi
    compilerVersion=$("$compiler" -version 2>&1) || die 'Building requires a full JDK 21+. Set JAVA_HOME to its directory and add its bin directory to PATH.'
    compilerMajor=$(printf '%s\n' "$compilerVersion" | sed -nE 's/^javac ([0-9]+).*/\1/p')
    [[ "$compilerMajor" =~ ^[0-9]+$ ]] && (( compilerMajor >= 21 )) || die 'Building requires JDK 21 or newer. Check JAVA_HOME and PATH.'
    command -v mvn >/dev/null 2>&1 || die 'Maven is required to build. Install Maven, then rerun this command.'
    (cd "$ROOT" && mvn package)
}

ensure_jar() {
    check_java
    if [[ ! -f "$JAR" ]] || [[ "$ROOT/pom.xml" -nt "$JAR" ]] ||
        [[ -n "$(find "$ROOT/src" -type f -newer "$JAR" -print -quit 2>/dev/null)" ]]; then
        build
    fi
}

run_doctor() {
    printf 'Java: '; if (check_java); then java -version 2>&1 | head -n 1; fi
    printf 'OS: %s (live capture requires Linux)\n' "$(uname -s)"
    for tool in mvn javac tcpdump iw sudo npm; do
        if command -v "$tool" >/dev/null 2>&1; then
            printf 'Available: %s\n' "$tool"
        else
            printf 'Missing: %s\n' "$tool"
        fi
    done
    printf 'Ops tools:\n'
    for tool in aireplay-ng tshark aircrack-ng hcxdumptool hcxpcapngtool mdk4 mdk3 hostapd dnsmasq python3; do
        if command -v "$tool" >/dev/null 2>&1; then
            printf '  Available: %s\n' "$tool"
        else
            printf '  Missing: %s\n' "$tool"
        fi
    done
    printf 'Build: JDK 21+ and Maven. Replay: Java 21+. Live: Linux, tcpdump, capture permissions.\n'
    printf 'Ops: run a live session, then use the Ops console readiness strip. Set -Drf.wordlist=/path/to/wordlist for a default wordlist.\n'
    printf 'Frontend: cd frontend && npm install (required once for the web dashboard).\n'
    if command -v iw >/dev/null 2>&1; then
        iw dev || printf 'Could not inspect wireless interfaces in this environment.\n'
    fi
}

run_live_session() {
    local iface=$1 rc=0
    [[ "$(uname -s)" == Linux ]] || die 'Live capture requires Linux. Use Replay a recording for offline PCAPs.'
    command -v tcpdump >/dev/null 2>&1 || die 'Live capture requires tcpdump on PATH.'
    command -v sudo >/dev/null 2>&1 || die 'Starting live capture requires sudo on PATH.'
    ensure_jar
    if prepare_monitor "$iface"; then
        :
    else
        local setup_status=$?
        if (( setup_status == 2 )); then return 0; fi
        return "$setup_status"
    fi
    trap cleanup_session EXIT
    trap 'exit 130' INT
    trap 'exit 143' TERM
    local java_bin
    java_bin=$(command -v java)
    SESSION_RAN=true
    start_frontend
    if (( EUID == 0 )); then
        "$java_bin" -jar "$JAR" --iface "$iface" --adaptive || rc=$?
    else
        sudo -H --preserve-env=JAVA_TOOL_OPTIONS -- "$java_bin" "-Drf.userHome=$HOME" -jar "$JAR" --iface "$iface" --adaptive || rc=$?
    fi
    return "$rc"
}

run_replay_session() {
    local file=$1 rc=0
    [[ -f "$file" && -r "$file" ]] || die "Replay file is not readable: $file"
    ensure_jar
    trap cleanup_session EXIT
    trap 'exit 130' INT
    trap 'exit 143' TERM
    local java_bin
    java_bin=$(command -v java)
    SESSION_RAN=true
    start_frontend
    "$java_bin" -jar "$JAR" --replay "$file" || rc=$?
    return "$rc"
}

run_dashboard_session() {
    ensure_jar
    trap cleanup_session EXIT
    trap 'exit 130' INT
    trap 'exit 143' TERM
    start_frontend
    java -jar "$JAR"
}

menu() {
    local choice file SESSION_RAN=false
    while true; do
        cat <<'EOF'

ewave

1. Live Wi-Fi
2. Replay a recording
3. Setup and diagnostics
4. Open dashboard without capture
0. Exit
EOF
        read -r -p 'Choose an option: ' choice || return 0
        case "$choice" in
            0) return 0 ;;
            1)
                choose_adapter || continue
                SESSION_RAN=false
                run_live_session "$CHOSEN_ADAPTER"
                if [[ "$SESSION_RAN" == true ]]; then return 0; fi ;;
            2)
                local -a pcaps=()
                local line
                while IFS= read -r line; do
                    [[ -n "$line" ]] && pcaps+=("$line")
                done < <(discover_pcaps)
                file=
                if (( ${#pcaps[@]} > 0 )); then
                    printf '\nAvailable recordings:\n'
                    local i=1 p
                    for p in "${pcaps[@]}"; do
                        printf '  %d) %s\n' "$i" "$p"
                        ((i++))
                    done
                    printf '  c) Custom PCAP path   0) Back\n'
                    read -r -p 'Choose recording # (Enter for first): ' choice || return 0
                    if [[ "$choice" == 0 ]]; then continue; fi
                    if [[ -z "$choice" ]]; then
                        file=${pcaps[0]}
                    elif [[ "$choice" == c ]]; then
                        read -r -p 'PCAP path: ' file || return 0
                        [[ -n "$file" ]] || continue
                    elif [[ "$choice" =~ ^[0-9]+$ ]] && (( choice >= 1 && choice <= ${#pcaps[@]} )); then
                        file=${pcaps[choice-1]}
                    else
                        printf 'Choose a listed option.\n'
                        continue
                    fi
                else
                    read -r -p 'PCAP path (Enter for bundled demo): ' file || return 0
                    if [[ -z "$file" ]]; then
                        file="$ROOT/src/test/resources/probes/probe-requests.pcap"
                    fi
                fi
                SESSION_RAN=false
                run_replay_session "$file"
                if [[ "$SESSION_RAN" == true ]]; then return 0; fi ;;
            3)
                printf '\n1) Check setup (doctor)   2) Build backend (build)   3) Restore Wi-Fi (restore)   0) Back\n'
                read -r -p 'Choose: ' choice || return 0
                case "$choice" in
                    1) run_doctor ;;
                    2) build ;;
                    3)
                        choose_adapter || continue
                        restore_network "$CHOSEN_ADAPTER" ;;
                    0) continue ;;
                    *) printf 'Choose a listed option.\n' ;;
                esac ;;
            4) run_dashboard_session; return $? ;;
            *) printf 'Choose a listed option.\n' ;;
        esac
    done
}

mode=${1:-menu}
if (( $# )); then shift; fi
case "$mode" in
    menu)
        (( $# == 0 )) || die 'Usage: ./ewave'
        menu ;;
    restore)
        (( $# == 1 )) || die 'Usage: ./ewave restore INTERFACE'
        restore_network "$1" ;;
    help|--help|-h)
        help ;;
    *)
        die "Unknown command: $mode. Just run ./ewave (or ./ewave --help)." ;;
esac
